# The Dockerfile runs `npm install` and then `COPY . .`, so anything built on a
# developer machine would overwrite the image's own install. A macOS
# node_modules copied over a linux image replaces esbuild with a Mach-O binary
# and the dev server dies with "The service is no longer running".
node_modules

# Dockerfile.k8s builds dist/ itself in its builder stage, so a host-built dist/
# must not leak into the build context.
dist

.git
.gitignore
.DS_Store
*.log
npm-debug.log*
.vite
coverage
